# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Optional: Model name (defaults to meta-llama/llama-3.3-70b-instruct:free if omitted)
# Examples: google/gemini-2.0-flash-exp:free, deepseek/deepseek-r1:free, openai/gpt-4o-mini
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Secret JWT Key
SECRET_KEY=origen_ai_persona_super_secret_jwt_key_2026
